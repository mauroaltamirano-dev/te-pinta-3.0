# Pin an exact n8n release and review its release notes before changing it.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.32.7
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=America/Argentina/Cordoba
EXECUTIONS_DATA_MAX_AGE=336

# Public HTTPS origin of the POS. Meta must be able to fetch signed media URLs
# returned by this origin; a tailnet-only URL is not sufficient.
POS_BASE_URL=http://tepinta-operational
POS_DOCKER_NETWORK=tepinta30_sail

# Non-secret Meta request configuration. Keep the version explicit so upgrades
# are deliberate. The access token belongs in an n8n Header Auth credential.
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=vXX.X
META_INSTAGRAM_USER_ID=
