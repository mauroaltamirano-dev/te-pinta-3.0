        {
            "parameters": {
                "mode": "runOnceForEachItem",
                "jsCode": "const mediaUrl = $json.body?.asset?.media_url;\nconst match =\n    typeof mediaUrl === 'string' &&\n    mediaUrl.match(\n        /^https:\\/\\/[a-zA-Z0-9.-]+(?::[0-9]+)?\\/media\\/instagram\\/[1-9][0-9]*\\/story\\.jpg\\?expires=([0-9]+)&signature=[a-f0-9]{64}$/,\n    );\nlet result = {\n    ok: false,\n    retryable: false,\n    failure: 'invalid_signed_media_url',\n};\nif (match && Number(match[1]) > Math.floor(Date.now() / 1000)) {\n    try {\n        const response = await this.helpers.httpRequest({\n            method: 'GET',\n            url: mediaUrl,\n            timeout: 15000,\n            returnFullResponse: true,\n            ignoreHttpStatusErrors: true,\n            disableFollowRedirect: true,\n            encoding: 'arraybuffer',\n        });\n        const status = Number(response.statusCode);\n        if (status !== 200) {\n            result = {\n                ok: false,\n                retryable: status === 429 || status >= 500,\n                failure: 'media_http_' + status,\n            };\n        } else {\n            const bytes = Buffer.from(response.body);\n            const mime = String(response.headers?.['content-type'] ?? '')\n                .split(';')[0]\n                .trim()\n                .toLowerCase();\n            const valid =\n                mime === 'image/jpeg' &&\n                bytes.length >= 4 &&\n                bytes.length <= 8 * 1024 * 1024 &&\n                bytes[0] === 0xff &&\n                bytes[1] === 0xd8 &&\n                bytes[2] === 0xff &&\n                bytes[bytes.length - 2] === 0xff &&\n                bytes[bytes.length - 1] === 0xd9;\n            result = {\n                ok: valid,\n                retryable: false,\n                failure: valid ? null : 'invalid_jpeg_response',\n            };\n        }\n    } catch {\n        result = {\n            ok: false,\n            retryable: true,\n            failure: 'media_request_failed',\n        };\n    }\n}\nreturn { json: { ...$json, resource_preflight: result } };\n"
            },
